#!/usr/bin/env bash
# Blocks commits over MAX_LINES changed lines, so changes stay small and reviewable.
# Samples, fixtures and lock files don't count.
set -euo pipefail

MAX_LINES=300
EXCLUDE='^(contracts/samples/|fixtures/|tests/claims_golden/)|\.lock$|-lock\.json$'

total=$(git diff --cached --numstat --no-renames \
  | awk -F'\t' -v ex="$EXCLUDE" '$1 != "-" && $3 !~ ex { s += $1 + $2 } END { print s + 0 }')

if [ "$total" -gt "$MAX_LINES" ]; then
  echo "Commit blocked: $total changed lines (limit $MAX_LINES)."
  echo "Split it into smaller commits, for example one per file or feature."
  git diff --cached --numstat --no-renames | awk -F'\t' '$1 != "-" { printf "  %5d  %s\n", $1 + $2, $3 }' | sort -rn | head -10
  exit 1
fi
