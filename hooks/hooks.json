{
  "description": "Receipts plugin hooks. SessionStart starts onboarding; PreToolUse asks the owner before a large payment. The receipt and Stop hooks land in later PRs.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__(plugin_ledgers-receipts_)?bakery-local__pay_bill$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/approve_payment.py\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
