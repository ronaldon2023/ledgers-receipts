{
  "description": "Receipts plugin hooks. SessionStart starts onboarding; PreToolUse asks the owner before a large payment. Stop builds the receipt after a payment and shows the owner its portal link.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__(plugin_ledgers-receipts_)?bakery-local__pay_bill$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/approve_payment.py\"",
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/show_receipt.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
