{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order_receipt.schema.json",
  "title": "Order receipt (draft v0)",
  "description": "One receipt per order. Created when the order is submitted (the PostToolUse hook on create_order), updated at each later step (payment, read-back), and finalized when the session stops. Stores check results only: the logic lives in the checks library named by checks_version, run with the policy named by policy.sha256, and verify reruns it. Only two shape rules live here: a sent payment has a payment_id, and a blocked or failed stage is logged. Replaces PLAN.md contract 4 for order receipts. Money is integer cents; every value is already masked, and no free-text field may hold an 8+ digit run. Ids and addresses come from bakery.db (contract 1), the system of record.",
  "type": "object",
  "required": [
    "receipt_type",
    "receipt_id",
    "generated_at",
    "business",
    "verdict",
    "order",
    "bill",
    "payment",
    "events",
    "checks",
    "summary_check",
    "read",
    "left_business",
    "pii",
    "sessions",
    "evidence",
    "checks_version",
    "policy"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "$ref": "#/$defs/text"
    },
    "receipt_type": {
      "const": "order-receipt/v0"
    },
    "receipt_id": {
      "$ref": "#/$defs/text"
    },
    "generated_at": {
      "$ref": "#/$defs/datetime"
    },
    "business": {
      "$ref": "#/$defs/party"
    },
    "verdict": {
      "enum": [
        "VERIFIED",
        "ISSUES_FOUND",
        "UNTRUSTED"
      ]
    },
    "verdict_reason": {
      "$ref": "#/$defs/text"
    },
    "owner_action": {
      "type": "object",
      "required": [
        "needed"
      ],
      "additionalProperties": false,
      "properties": {
        "needed": {
          "type": "boolean"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "why": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "order": {
      "type": "object",
      "required": [
        "order_number",
        "order_date",
        "seller",
        "items",
        "currency",
        "total_cents"
      ],
      "additionalProperties": false,
      "properties": {
        "order_number": {
          "$ref": "#/$defs/text"
        },
        "order_date": {
          "$ref": "#/$defs/datetime"
        },
        "seller": {
          "$ref": "#/$defs/party",
          "description": "A vendors row"
        },
        "customer": {
          "$ref": "#/$defs/party"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "quantity",
              "unit_price_cents",
              "total_cents"
            ],
            "additionalProperties": false,
            "properties": {
              "sku": {
                "$ref": "#/$defs/text"
              },
              "name": {
                "$ref": "#/$defs/text"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "unit_price_cents": {
                "$ref": "#/$defs/cents"
              },
              "total_cents": {
                "$ref": "#/$defs/cents"
              }
            }
          }
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "subtotal_cents": {
          "$ref": "#/$defs/cents"
        },
        "tax_cents": {
          "$ref": "#/$defs/cents"
        },
        "total_cents": {
          "$ref": "#/$defs/cents"
        }
      }
    },
    "bill": {
      "type": [
        "object",
        "null"
      ],
      "description": "The supplier's bill: a bills row. Not the invoices table, which holds what customers owe.",
      "required": [
        "bill_id",
        "vendor_id",
        "references_order",
        "amount_cents",
        "due_date"
      ],
      "additionalProperties": false,
      "properties": {
        "bill_id": {
          "$ref": "#/$defs/text"
        },
        "vendor_id": {
          "$ref": "#/$defs/text"
        },
        "references_order": {
          "$ref": "#/$defs/text"
        },
        "received_at": {
          "$ref": "#/$defs/datetime"
        },
        "from": {
          "$ref": "#/$defs/text"
        },
        "amount_cents": {
          "$ref": "#/$defs/cents"
        },
        "due_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "payment": {
      "type": "object",
      "description": "status is the one source of payment state; the UI derives order and bill status from it",
      "required": [
        "status",
        "amount_cents",
        "payment_id"
      ],
      "additionalProperties": false,
      "properties": {
        "payment_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "A payments row id; set only when status is sent"
        },
        "status": {
          "enum": [
            "not_started",
            "blocked",
            "sent",
            "failed"
          ]
        },
        "amount_cents": {
          "$ref": "#/$defs/cents"
        },
        "requested_to_account": {
          "$ref": "#/$defs/masked"
        },
        "account_on_file": {
          "$ref": "#/$defs/masked"
        },
        "method": {
          "$ref": "#/$defs/text"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "sent"
          }
        }
      },
      "then": {
        "properties": {
          "payment_id": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "else": {
        "properties": {
          "payment_id": {
            "type": "null"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "at",
          "actor",
          "status",
          "source",
          "checks"
        ],
        "additionalProperties": false,
        "properties": {
          "stage": {
            "$ref": "#/$defs/stage"
          },
          "at": {
            "oneOf": [
              {
                "$ref": "#/$defs/datetime"
              },
              {
                "type": "null"
              }
            ]
          },
          "actor": {
            "enum": [
              "agent",
              "human",
              "supplier",
              "trigger"
            ]
          },
          "status": {
            "enum": [
              "done",
              "blocked",
              "failed",
              "not_reached"
            ]
          },
          "source": {
            "enum": [
              "log",
              "unverified"
            ],
            "description": "unverified: nothing in our logs shows this stage, so the UI marks it unverified"
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/text"
            },
            "description": "ids from checks[]"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "const": "log"
                },
                "status": {
                  "enum": [
                    "done",
                    "blocked",
                    "failed"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "at": {
                  "$ref": "#/$defs/text"
                },
                "checks": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "description": "A block or failure is always logged",
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "blocked",
                    "failed"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "source": {
                  "const": "log"
                }
              }
            }
          }
        ]
      },
      "description": "One entry per order stage, in order"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "lifecycle_stage",
          "kind",
          "title",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "status": {
            "description": "PLAN.md contract 4 statuses, plus flagged, needs_approval, and rerun_mismatch (a stored result that differs from verify's rerun)",
            "enum": [
              "verified",
              "blocked",
              "flagged",
              "needs_approval",
              "phantom",
              "false_claim",
              "silent_action",
              "not_done",
              "unknown_recipient",
              "rerun_mismatch"
            ]
          },
          "lifecycle_stage": {
            "$ref": "#/$defs/stage"
          },
          "kind": {
            "description": "What did the checking; receipt_issues.json calls this stage",
            "enum": [
              "policy",
              "guard",
              "records",
              "summary"
            ]
          },
          "guard": {
            "enum": [
              "email_spoofing",
              "policy",
              "security"
            ]
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "evidence": {
            "$ref": "#/$defs/refs"
          },
          "caused_by": {
            "type": "object",
            "required": [
              "ref",
              "quote"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "$ref": "#/$defs/ref"
              },
              "quote": {
                "$ref": "#/$defs/text"
              }
            }
          },
          "quote": {
            "$ref": "#/$defs/text",
            "description": "exact text from Claude's summary"
          },
          "inputs": {
            "type": "object",
            "description": "The masked values the check compared, so anyone can rerun it",
            "additionalProperties": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "summary_check": {
      "type": "object",
      "description": "Whether Claude's summary was checked. A failed claim extractor shows here, never as a clean receipt.",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "checked",
            "not_checked",
            "error"
          ]
        },
        "error": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "read": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "$ref": "#/$defs/text"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "left_business": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "to",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/$defs/text"
          },
          "to": {
            "$ref": "#/$defs/text"
          },
          "summary": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "pii": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity",
          "where",
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "entity": {
            "$ref": "#/$defs/text",
            "description": "Presidio entity type"
          },
          "where": {
            "$ref": "#/$defs/ref"
          },
          "action": {
            "enum": [
              "masked",
              "blocked"
            ]
          }
        }
      }
    },
    "sessions": {
      "type": "array",
      "description": "One hash chain per Claude session that worked on the order",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "session",
          "ok",
          "entries",
          "head"
        ],
        "additionalProperties": false,
        "properties": {
          "session": {
            "type": "string",
            "pattern": "^s[0-9]+$"
          },
          "started_at": {
            "$ref": "#/$defs/datetime"
          },
          "ok": {
            "type": "boolean"
          },
          "entries": {
            "type": "integer",
            "minimum": 0
          },
          "head": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "Masked one-line excerpts keyed by ref",
      "propertyNames": {
        "$ref": "#/$defs/ref"
      },
      "additionalProperties": {
        "$ref": "#/$defs/text"
      }
    },
    "checks_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$",
      "description": "Git commit of the checks library that produced checks[] and verdict"
    },
    "policy": {
      "type": "object",
      "required": [
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Hash of the policy.json that ran"
        }
      }
    }
  },
  "$defs": {
    "cents": {
      "type": "integer",
      "minimum": 0
    },
    "datetime": {
      "type": "string",
      "format": "date-time"
    },
    "masked": {
      "type": "string",
      "pattern": "^\\*+[0-9]{4}$"
    },
    "text": {
      "type": "string",
      "not": {
        "pattern": "[0-9]{8,}"
      },
      "description": "Free text: no account-length digit run"
    },
    "ref": {
      "type": "string",
      "pattern": "^(s[0-9]+:log:[0-9]+|inbox:[0-9]+|summary)$"
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "stage": {
      "enum": [
        "order_placed",
        "order_sent",
        "fulfilled",
        "bill_received",
        "payment_ready",
        "payment_sent"
      ]
    },
    "party": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "email": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
