{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order_receipt.schema.json",
  "title": "Order receipt (draft v0)",
  "description": "One receipt per order. Created when the order is submitted (the PostToolUse hook on create_order), updated at each step after that (approval, payment, read-back), and finalized when the session stops. Replaces PLAN.md contract 4 for order receipts. Money is integer cents; every value is already masked, and no free-text field may hold an 8+ digit run. Ids and addresses come from bakery.db (contract 1). Order field names follow schema.org Order where one fits.",
  "type": "object",
  "required": ["receipt_type", "receipt_id", "generated_at", "business", "verdict", "order", "bill", "payment",
               "lifecycle", "checks", "summary_check", "read", "left_business", "pii", "sessions", "evidence"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"$ref": "#/$defs/text"},
    "receipt_type": {"const": "order-receipt/v0"},
    "receipt_id": {"$ref": "#/$defs/text"},
    "supersedes": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}], "description": "receipt_id of an earlier receipt for the same order"},
    "generated_at": {"$ref": "#/$defs/datetime"},
    "business": {"$ref": "#/$defs/party"},
    "verdict": {"enum": ["VERIFIED", "ISSUES_FOUND", "UNTRUSTED"]},
    "verdict_reason": {"$ref": "#/$defs/text"},
    "owner_action": {
      "type": "object",
      "required": ["needed"],
      "additionalProperties": false,
      "properties": {"needed": {"type": "boolean"}, "title": {"$ref": "#/$defs/text"}, "why": {"$ref": "#/$defs/text"}}
    },
    "order": {
      "type": "object",
      "required": ["order_number", "order_date", "seller", "items", "currency", "total_cents"],
      "additionalProperties": false,
      "properties": {
        "order_number": {"$ref": "#/$defs/text"},
        "order_date": {"$ref": "#/$defs/datetime"},
        "seller": {"$ref": "#/$defs/party", "description": "A vendors row"},
        "customer": {"$ref": "#/$defs/party"},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "quantity", "unit_price_cents", "total_cents"],
            "additionalProperties": false,
            "properties": {
              "sku": {"$ref": "#/$defs/text"},
              "name": {"$ref": "#/$defs/text"},
              "quantity": {"type": "integer", "minimum": 1},
              "unit_price_cents": {"$ref": "#/$defs/cents"},
              "total_cents": {"$ref": "#/$defs/cents"}
            }
          }
        },
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "subtotal_cents": {"$ref": "#/$defs/cents"},
        "tax_cents": {"$ref": "#/$defs/cents"},
        "total_cents": {"$ref": "#/$defs/cents"}
      }
    },
    "bill": {
      "type": ["object", "null"],
      "description": "The supplier's bill: a bills row. Not the invoices table, which holds what customers owe.",
      "required": ["bill_id", "vendor_id", "references_order", "amount_cents", "due_date"],
      "additionalProperties": false,
      "properties": {
        "bill_id": {"$ref": "#/$defs/text"},
        "vendor_id": {"$ref": "#/$defs/text"},
        "vendor_invoice_number": {"$ref": "#/$defs/text", "description": "The supplier's own number, when it differs from bill_id"},
        "references_order": {"$ref": "#/$defs/text"},
        "received_at": {"$ref": "#/$defs/datetime"},
        "from": {"$ref": "#/$defs/text"},
        "amount_cents": {"$ref": "#/$defs/cents"},
        "due_date": {"type": "string", "format": "date"}
      }
    },
    "payment": {
      "type": "object",
      "description": "status is the one source of payment state; the UI derives order and bill status from it",
      "required": ["status", "amount_cents", "payment_id"],
      "additionalProperties": false,
      "properties": {
        "payment_id": {"type": ["string", "null"], "description": "A payments row id; set only when status is sent"},
        "status": {"enum": ["not_started", "blocked", "sent", "failed"]},
        "amount_cents": {"$ref": "#/$defs/cents"},
        "requested_to_account": {"$ref": "#/$defs/masked"},
        "account_on_file": {"$ref": "#/$defs/masked"},
        "method": {"$ref": "#/$defs/text"}
      },
      "if": {"properties": {"status": {"const": "sent"}}},
      "then": {"properties": {"payment_id": {"$ref": "#/$defs/text"}}},
      "else": {"properties": {"payment_id": {"type": "null"}}}
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested_by": {"$ref": "#/$defs/actor"},
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "by", "method", "at", "evidence"],
            "additionalProperties": false,
            "properties": {
              "step": {"$ref": "#/$defs/stage"},
              "by": {"$ref": "#/$defs/actor"},
              "method": {"enum": ["passkey"], "description": "Whiteboard plan; no component records approvals yet"},
              "at": {"$ref": "#/$defs/datetime"},
              "evidence": {"$ref": "#/$defs/refs"}
            }
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "description": "Definitions only. Results live in checks.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "title"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/text"},
          "kind": {"enum": ["order", "payment", "budget"]},
          "title": {"$ref": "#/$defs/text"},
          "limit_cents": {"$ref": "#/$defs/cents"}
        }
      }
    },
    "lifecycle": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "at", "actor", "status", "source", "checks"],
        "additionalProperties": false,
        "properties": {
          "stage": {"$ref": "#/$defs/stage"},
          "at": {"oneOf": [{"$ref": "#/$defs/datetime"}, {"type": "null"}]},
          "actor": {"enum": ["agent", "human", "supplier", "trigger"]},
          "status": {"enum": ["done", "blocked", "failed", "not_reached"]},
          "source": {
            "enum": ["log", "unverified"],
            "description": "unverified: nothing in our logs shows this stage, so the UI marks it unverified"
          },
          "checks": {"type": "array", "items": {"$ref": "#/$defs/text"}, "description": "ids from checks[]"}
        },
        "allOf": [
          {
            "if": {"properties": {"source": {"const": "log"}, "status": {"enum": ["done", "blocked", "failed"]}}},
            "then": {"properties": {"at": {"$ref": "#/$defs/text"}, "checks": {"minItems": 1}}}
          },
          {
            "description": "A block or failure is always logged",
            "if": {"properties": {"status": {"enum": ["blocked", "failed"]}}},
            "then": {"properties": {"source": {"const": "log"}}}
          }
        ]
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "lifecycle_stage", "kind", "title", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/text"},
          "status": {
            "description": "PLAN.md contract 4 statuses, plus flagged and needs_approval",
            "enum": ["verified", "blocked", "flagged", "needs_approval", "phantom", "false_claim",
                     "silent_action", "not_done", "unknown_recipient"]
          },
          "lifecycle_stage": {"$ref": "#/$defs/stage"},
          "kind": {
            "description": "What did the checking; receipt_issues.json calls this stage",
            "enum": ["policy", "guard", "records", "summary"]
          },
          "guard": {"enum": ["email_spoofing", "policy", "security"]},
          "policy_id": {"$ref": "#/$defs/text"},
          "title": {"$ref": "#/$defs/text"},
          "measured": {
            "type": "object",
            "description": "Figures a budget check compared; projected means the payment has not happened",
            "required": ["as_of", "projected"],
            "additionalProperties": false,
            "properties": {
              "as_of": {"$ref": "#/$defs/datetime"},
              "projected": {"type": "boolean"},
              "limit_cents": {"$ref": "#/$defs/cents"},
              "used_cents": {"$ref": "#/$defs/cents"},
              "balance_cents": {"$ref": "#/$defs/cents"},
              "after_cents": {"$ref": "#/$defs/cents"}
            }
          },
          "evidence": {"$ref": "#/$defs/refs"},
          "caused_by": {
            "type": "object",
            "required": ["ref", "quote"],
            "additionalProperties": false,
            "properties": {"ref": {"$ref": "#/$defs/ref"}, "quote": {"$ref": "#/$defs/text"}}
          },
          "quote": {"$ref": "#/$defs/text", "description": "exact text from Claude's summary"}
        }
      }
    },
    "summary_check": {
      "type": "object",
      "description": "Whether Claude's summary was checked. A failed claim extractor shows here, never as a clean receipt.",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {"status": {"enum": ["checked", "not_checked", "error"]}, "error": {"$ref": "#/$defs/text"}}
    },
    "read": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "count"],
        "additionalProperties": false,
        "properties": {"source": {"$ref": "#/$defs/text"}, "count": {"type": "integer", "minimum": 0}}
      }
    },
    "left_business": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "to", "summary"],
        "additionalProperties": false,
        "properties": {"action": {"$ref": "#/$defs/text"}, "to": {"$ref": "#/$defs/text"}, "summary": {"$ref": "#/$defs/text"}}
      }
    },
    "pii": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity", "where", "action"],
        "additionalProperties": false,
        "properties": {
          "entity": {"$ref": "#/$defs/text", "description": "Presidio entity type"},
          "where": {"$ref": "#/$defs/ref"},
          "action": {"enum": ["masked", "blocked"]}
        }
      }
    },
    "sessions": {
      "type": "array",
      "description": "One hash chain per Claude session that worked on the order",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["session", "ok", "entries", "head"],
        "additionalProperties": false,
        "properties": {
          "session": {"type": "string", "pattern": "^s[0-9]+$"},
          "started_at": {"$ref": "#/$defs/datetime"},
          "ok": {"type": "boolean"},
          "entries": {"type": "integer", "minimum": 0},
          "head": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "Masked one-line excerpts keyed by ref",
      "propertyNames": {"$ref": "#/$defs/ref"},
      "additionalProperties": {"$ref": "#/$defs/text"}
    }
  },
  "allOf": [
    {
      "description": "Any broken chain makes the whole receipt untrusted",
      "if": {"properties": {"sessions": {"contains": {"properties": {"ok": {"const": false}}}}}},
      "then": {"properties": {"verdict": {"const": "UNTRUSTED"}}}
    },
    {
      "description": "UNTRUSTED only when a chain is broken",
      "if": {"properties": {"verdict": {"const": "UNTRUSTED"}}},
      "then": {"properties": {"sessions": {"contains": {"properties": {"ok": {"const": false}}}}}}
    },
    {
      "description": "VERIFIED needs every check verified, the summary checked, no stage blocked or failed, and nothing left for the owner",
      "if": {"properties": {"verdict": {"const": "VERIFIED"}}},
      "then": {
        "properties": {
          "checks": {"items": {"properties": {"status": {"const": "verified"}}}},
          "summary_check": {"properties": {"status": {"const": "checked"}}},
          "payment": {"properties": {"status": {"enum": ["not_started", "sent"]}}},
          "lifecycle": {"items": {"properties": {"status": {"enum": ["done", "not_reached"]}}}},
          "owner_action": {"properties": {"needed": {"const": false}}}
        }
      }
    },
    {
      "description": "ISSUES_FOUND needs a check that is not verified, or a summary that could not be checked",
      "if": {"properties": {"verdict": {"const": "ISSUES_FOUND"}}},
      "then": {
        "anyOf": [
          {"properties": {"checks": {"contains": {"properties": {"status": {"not": {"const": "verified"}}}}}}},
          {"properties": {"summary_check": {"properties": {"status": {"enum": ["not_checked", "error"]}}}}}
        ]
      }
    },
    {
      "description": "An unchecked summary has no summary checks",
      "if": {"properties": {"summary_check": {"properties": {"status": {"enum": ["not_checked", "error"]}}}}},
      "then": {"properties": {"checks": {"not": {"contains": {"properties": {"kind": {"const": "summary"}}}}}}}
    },
    {
      "description": "payment.status sent means the payment_sent stage is done, and only done",
      "if": {"properties": {"payment": {"properties": {"status": {"const": "sent"}}}}},
      "then": {"properties": {"lifecycle": {"$ref": "#/$defs/payment_stage_is_done"}}}
    },
    {
      "description": "payment.status blocked means the payment_sent stage is blocked, and only blocked",
      "if": {"properties": {"payment": {"properties": {"status": {"const": "blocked"}}}}},
      "then": {"properties": {"lifecycle": {"$ref": "#/$defs/payment_stage_is_blocked"}}}
    },
    {
      "description": "payment.status failed means the payment_sent stage is failed, and only failed",
      "if": {"properties": {"payment": {"properties": {"status": {"const": "failed"}}}}},
      "then": {"properties": {"lifecycle": {"$ref": "#/$defs/payment_stage_is_failed"}}}
    },
    {
      "description": "payment.status not_started means the payment_sent stage is absent or not reached",
      "if": {"properties": {"payment": {"properties": {"status": {"const": "not_started"}}}}},
      "then": {
        "properties": {
          "lifecycle": {
            "not": {"contains": {"properties": {"stage": {"const": "payment_sent"}, "status": {"not": {"const": "not_reached"}}}}}
          }
        }
      }
    },
    {
      "description": "An error message only accompanies a summary check that errored",
      "if": {"properties": {"summary_check": {"properties": {"status": {"enum": ["checked", "not_checked"]}}}}},
      "then": {"properties": {"summary_check": {"not": {"required": ["error"]}}}}
    }
  ],
  "$defs": {
    "cents": {"type": "integer", "minimum": 0},
    "datetime": {"type": "string", "format": "date-time"},
    "masked": {"type": "string", "pattern": "^\\*+[0-9]{4}$"},
    "text": {"type": "string", "not": {"pattern": "[0-9]{8,}"}, "description": "Free text: no account-length digit run"},
    "payment_stage_is_done": {
      "contains": {"properties": {"stage": {"const": "payment_sent"}, "status": {"const": "done"}}},
      "not": {"contains": {"properties": {"stage": {"const": "payment_sent"}, "status": {"not": {"const": "done"}}}}}
    },
    "payment_stage_is_blocked": {
      "contains": {"properties": {"stage": {"const": "payment_sent"}, "status": {"const": "blocked"}}},
      "not": {"contains": {"properties": {"stage": {"const": "payment_sent"}, "status": {"not": {"const": "blocked"}}}}}
    },
    "payment_stage_is_failed": {
      "contains": {"properties": {"stage": {"const": "payment_sent"}, "status": {"const": "failed"}}},
      "not": {"contains": {"properties": {"stage": {"const": "payment_sent"}, "status": {"not": {"const": "failed"}}}}}
    },
    "ref": {"type": "string", "pattern": "^(s[0-9]+:log:[0-9]+|inbox:[0-9]+|summary)$"},
    "refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "stage": {"enum": ["order_placed", "order_sent", "fulfilled", "bill_received", "payment_ready", "payment_sent"]},
    "party": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}, "email": {"$ref": "#/$defs/text"}}
    },
    "actor": {
      "type": "object",
      "required": ["kind", "name"],
      "additionalProperties": false,
      "properties": {"kind": {"enum": ["agent", "human"]}, "name": {"$ref": "#/$defs/text"}, "session": {"$ref": "#/$defs/text"}}
    }
  }
}
